(ns enveng.governor
  "EnvengGovernor — the independent safety/traceability layer for
  the ISCO-08 2143 environmental engineer actor. Wired as its own
  `:govern` node in `enveng.actor`'s StateGraph, downstream of
  `:advise` — the Advisor has no notion of project provenance,
  regulatory responsibility, or the environmental engineer's professional/
  legal responsibility, so this MUST be a separate system able to reject
  a proposal (itonami actor pattern, per ADR-2607011000 / CLAUDE.md
  Actors section).

  `check` is a pure function of (request, context, proposal, store) ->
  verdict; it never mutates the store. The StateGraph's `:decide` node
  routes on the verdict:
    :hard? true                → :hold  (irreversible, no write)
    :escalate? true            → :request-approval (interrupt-before)
    otherwise                  → :commit

  HARD invariants (:hard? true, ALWAYS :hold, never overridable):
    1. project provenance  — the request's project must be registered.
    2. no-actuation        — proposal :effect must be :propose.
    3. no-certification    — any attempt to issue a final certified
       engineering design or compliance certification is a permanent
       block (that is the licensed environmental engineer's exclusive
       professional responsibility).
    4. closed vocabulary   — an `:op` that `enveng.operations` neither
       permits nor forbids is refused (`:unknown-op`), including the `:unknown`
       the advisor emits for an unreadable LLM reply.
  ESCALATION invariants (:escalate? true, ALWAYS human sign-off, per the
  README robotics-premise: certified designs and compliance certification
  always require human engineer sign-off):
    5. :op :flag-regulatory-risk (always escalates).
    6. remediation plans touching hazardous-material handling.
    7. low confidence (< `confidence-floor`)."
  (:require [enveng.store :as store]
            [enveng.operations :as operations]))

(def confidence-floor 0.6)
(def ^:private escalating-ops #{:flag-regulatory-risk})
(def ^:private hazmat-keywords #{:hazardous :contaminated :heavy-metals :pcb :asbestos :petroleum :pah})

(defn- hard-violations [{:keys [proposal]} project-record]
  (cond-> []
    (nil? project-record)
    (conj {:rule :no-project :detail "未登録 project"})

    (not= :propose (:effect proposal))
    (conj {:rule :no-actuation :detail "effect は :propose のみ許可（直接書込禁止）"})

    (operations/forbidden? (:op proposal))
    (conj {:rule :no-certification :detail "certified engineering designs and compliance certification are licensed engineer's exclusive responsibility"})

    (operations/unknown? (:op proposal))
    (conj {:rule :unknown-op :detail (str "op " (pr-str (:op proposal)) " is not in enveng.operations")})))

(defn- hazmat-handling? [{:keys [scope tags]}]
  (and scope tags (some hazmat-keywords tags)))

(defn check
  "Assess a proposal against `request`/`context`/`proposal` and a
  `store` implementing `enveng.store/Store`. Returns
  `{:ok? bool :violations [...] :confidence n :hard? bool :escalate? bool}`."
  [request context proposal store]
  (let [project-record (store/project store (:project-id request))
        hard (hard-violations {:proposal proposal} project-record)
        hard? (boolean (seq hard))
        conf (or (:confidence proposal) 0.0)
        low? (< conf confidence-floor)
        escalating-op? (contains? escalating-ops (:op proposal))
        hazmat? (and (not hard?) (hazmat-handling? proposal))]
    {:ok? (and (not hard?) (not low?) (not escalating-op?) (not hazmat?))
     :violations hard
     :confidence conf
     :hard? hard?
     :escalate? (and (not hard?) (or low? escalating-op? hazmat?))}))
